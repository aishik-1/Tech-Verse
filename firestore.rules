rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Hardened Global Helper Functions ---
    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'aishik.roy1234@gmail.com' ||
        request.auth.token.email == 'admin@techverse.bst.edu' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    // Connection test document
    match /test/{docId} {
      allow get: if true;
      allow list, write: if false;
    }

    // Admins registry
    match /admins/{adminId} {
      allow get: if isSignedIn();
      allow list: if isAdmin();
      allow write: if false;
    }

    // --- Entity Validators ---
    function isValidProfile(data) {
      return data.keys().hasAll(['id', 'full_name', 'email', 'role', 'is_active', 'created_at', 'updated_at']) &&
        data.keys().hasOnly(['id', 'full_name', 'email', 'avatar_url', 'bio', 'roll_number', 'year', 'role', 'github_username', 'is_active', 'created_at', 'updated_at']) &&
        data.id is string && isValidId(data.id) &&
        data.full_name is string && data.full_name.size() > 0 && data.full_name.size() <= 120 &&
        data.email is string && data.email.size() <= 120 &&
        (!('avatar_url' in data) || (data.avatar_url is string && data.avatar_url.size() <= 1000)) &&
        (!('bio' in data) || (data.bio is string && data.bio.size() <= 500)) &&
        (!('roll_number' in data) || (data.roll_number is string && data.roll_number.size() <= 64)) &&
        (!('year' in data) || (data.year is string && data.year.size() <= 64)) &&
        data.role in ['student', 'admin'] &&
        (!('github_username' in data) || (data.github_username is string && data.github_username.size() <= 100)) &&
        data.is_active is bool &&
        data.created_at is string && data.created_at.size() <= 64 &&
        data.updated_at is string && data.updated_at.size() <= 64;
    }

    function isValidPublicProfile(data) {
      return data.keys().hasAll(['id', 'full_name', 'role', 'is_active', 'created_at']) &&
        data.keys().hasOnly(['id', 'full_name', 'avatar_url', 'bio', 'roll_number', 'year', 'role', 'github_username', 'is_active', 'created_at', 'updated_at']) &&
        data.id is string && isValidId(data.id) &&
        data.full_name is string && data.full_name.size() > 0 && data.full_name.size() <= 120 &&
        (!('avatar_url' in data) || (data.avatar_url is string && data.avatar_url.size() <= 1000)) &&
        (!('bio' in data) || (data.bio is string && data.bio.size() <= 500)) &&
        (!('roll_number' in data) || (data.roll_number is string && data.roll_number.size() <= 64)) &&
        (!('year' in data) || (data.year is string && data.year.size() <= 64)) &&
        data.role in ['student', 'admin'] &&
        (!('github_username' in data) || (data.github_username is string && data.github_username.size() <= 100)) &&
        data.is_active is bool &&
        data.created_at is string && data.created_at.size() <= 64;
    }

    function isValidSticker(data) {
      return data.keys().hasAll(['id', 'user_id', 'event_name', 'sticker_name', 'category', 'created_at']) &&
        data.keys().hasOnly(['id', 'user_id', 'user_name', 'user_avatar', 'event_name', 'sticker_name', 'event_date', 'image_url', 'category', 'created_at']) &&
        data.id is string && isValidId(data.id) &&
        data.user_id is string && isValidId(data.user_id) &&
        (!('user_name' in data) || (data.user_name is string && data.user_name.size() <= 120)) &&
        (!('user_avatar' in data) || (data.user_avatar is string && data.user_avatar.size() <= 1000)) &&
        data.event_name is string && data.event_name.size() > 0 && data.event_name.size() <= 150 &&
        data.sticker_name is string && data.sticker_name.size() > 0 && data.sticker_name.size() <= 150 &&
        (!('event_date' in data) || (data.event_date is string && data.event_date.size() <= 64)) &&
        (!('image_url' in data) || (data.image_url is string && data.image_url.size() <= 2000)) &&
        data.category is string && data.category.size() <= 64 &&
        data.created_at is string && data.created_at.size() <= 64;
    }

    function isValidAchievement(data) {
      return data.keys().hasAll(['id', 'user_id', 'title', 'category', 'organization', 'created_at', 'updated_at']) &&
        data.keys().hasOnly(['id', 'user_id', 'user_name', 'user_avatar', 'title', 'description', 'category', 'organization', 'achievement_date', 'image_url', 'proof_link', 'created_at', 'updated_at']) &&
        data.id is string && isValidId(data.id) &&
        data.user_id is string && isValidId(data.user_id) &&
        (!('user_name' in data) || (data.user_name is string && data.user_name.size() <= 120)) &&
        (!('user_avatar' in data) || (data.user_avatar is string && data.user_avatar.size() <= 1000)) &&
        data.title is string && data.title.size() > 0 && data.title.size() <= 200 &&
        (!('description' in data) || (data.description is string && data.description.size() <= 1000)) &&
        data.category is string && data.category.size() <= 64 &&
        data.organization is string && data.organization.size() <= 150 &&
        (!('achievement_date' in data) || (data.achievement_date is string && data.achievement_date.size() <= 64)) &&
        (!('image_url' in data) || (data.image_url is string && data.image_url.size() <= 2000)) &&
        (!('proof_link' in data) || (data.proof_link is string && data.proof_link.size() <= 1000)) &&
        data.created_at is string && data.created_at.size() <= 64 &&
        data.updated_at is string && data.updated_at.size() <= 64;
    }

    function isValidIdea(data) {
      return data.keys().hasAll(['id', 'user_id', 'title', 'description', 'category', 'likes_count', 'created_at', 'updated_at']) &&
        data.keys().hasOnly(['id', 'user_id', 'user_name', 'user_avatar', 'title', 'description', 'category', 'likes_count', 'created_at', 'updated_at']) &&
        data.id is string && isValidId(data.id) &&
        data.user_id is string && isValidId(data.user_id) &&
        (!('user_name' in data) || (data.user_name is string && data.user_name.size() <= 120)) &&
        (!('user_avatar' in data) || (data.user_avatar is string && data.user_avatar.size() <= 1000)) &&
        data.title is string && data.title.size() > 0 && data.title.size() <= 200 &&
        data.description is string && data.description.size() > 0 && data.description.size() <= 2000 &&
        data.category is string && data.category.size() <= 64 &&
        data.likes_count is number &&
        data.created_at is string && data.created_at.size() <= 64 &&
        data.updated_at is string && data.updated_at.size() <= 64;
    }

    function isValidIdeaLike(data) {
      return data.keys().hasAll(['id', 'idea_id', 'user_id', 'created_at']) &&
        data.keys().hasOnly(['id', 'idea_id', 'user_id', 'created_at']) &&
        data.id is string && isValidId(data.id) &&
        data.idea_id is string && isValidId(data.idea_id) &&
        data.user_id is string && isValidId(data.user_id) &&
        data.created_at is string && data.created_at.size() <= 64;
    }

    function isValidChatMessage(data) {
      return data.keys().hasAll(['id', 'user_id', 'user_name', 'message', 'created_at']) &&
        data.keys().hasOnly(['id', 'user_id', 'user_name', 'user_avatar', 'user_role', 'message', 'created_at']) &&
        data.id is string && isValidId(data.id) &&
        data.user_id is string && isValidId(data.user_id) &&
        data.user_name is string && data.user_name.size() > 0 && data.user_name.size() <= 120 &&
        (!('user_avatar' in data) || (data.user_avatar is string && data.user_avatar.size() <= 1000)) &&
        (!('user_role' in data) || (data.user_role is string && data.user_role.size() <= 32)) &&
        data.message is string && data.message.size() > 0 && data.message.size() <= 1000 &&
        data.created_at is string && data.created_at.size() <= 64;
    }

    // --- Collection Rules ---

    // 1. Private Profiles (with PII email) - Strictly isolated
    match /profiles/{userId} {
      allow get: if isValidId(userId) && (isOwner(userId) || isAdmin());
      allow list: if isAdmin();
      allow create: if isValidId(userId) && isOwner(userId) && isValidProfile(incoming()) && (
        incoming().role == 'student' || isAdmin()
      );
      allow update: if isValidId(userId) && (isOwner(userId) || isAdmin()) && isValidProfile(incoming()) &&
        incoming().id == existing().id &&
        incoming().created_at == existing().created_at &&
        (incoming().role == existing().role || isAdmin());
      allow delete: if isValidId(userId) && isAdmin();
    }

    // 2. Public Profiles (Sanitized, NO PII email) - Community Directory
    match /public_profiles/{userId} {
      allow get, list: if isValidId(userId);
      allow create: if isValidId(userId) && isOwner(userId) && isValidPublicProfile(incoming()) && (
        incoming().role == 'student' || isAdmin()
      );
      allow update: if isValidId(userId) && (isOwner(userId) || isAdmin()) && isValidPublicProfile(incoming()) &&
        incoming().id == existing().id &&
        (incoming().role == existing().role || isAdmin());
      allow delete: if isValidId(userId) && isAdmin();
    }

    // 3. Stickers
    match /stickers/{stickerId} {
      allow get, list: if true;
      allow create: if isValidId(stickerId) && isSignedIn() && isValidSticker(incoming()) &&
        incoming().user_id == request.auth.uid;
      allow update: if isValidId(stickerId) && isSignedIn() && isValidSticker(incoming()) &&
        (existing().user_id == request.auth.uid || isAdmin()) &&
        incoming().id == existing().id &&
        incoming().user_id == existing().user_id;
      allow delete: if isValidId(stickerId) && isSignedIn() &&
        (existing().user_id == request.auth.uid || isAdmin());
    }

    // 4. Achievements
    match /achievements/{achievementId} {
      allow get, list: if true;
      allow create: if isValidId(achievementId) && isSignedIn() && isValidAchievement(incoming()) &&
        incoming().user_id == request.auth.uid;
      allow update: if isValidId(achievementId) && isSignedIn() && isValidAchievement(incoming()) &&
        (existing().user_id == request.auth.uid || isAdmin()) &&
        incoming().id == existing().id &&
        incoming().user_id == existing().user_id;
      allow delete: if isValidId(achievementId) && isSignedIn() &&
        (existing().user_id == request.auth.uid || isAdmin());
    }

    // 5. Ideas
    match /ideas/{ideaId} {
      allow get, list: if true;
      allow create: if isValidId(ideaId) && isSignedIn() && isValidIdea(incoming()) &&
        incoming().user_id == request.auth.uid &&
        incoming().likes_count == 0;
      allow update: if isValidId(ideaId) && isSignedIn() && isValidIdea(incoming()) && (
        // Action: Owner editing content
        (existing().user_id == request.auth.uid &&
         incoming().id == existing().id &&
         incoming().user_id == existing().user_id &&
         incoming().likes_count == existing().likes_count &&
         incoming().diff(existing()).affectedKeys().hasOnly(['title', 'description', 'category', 'updated_at'])) ||
        // Action: Like counter increment/decrement
        (incoming().id == existing().id &&
         incoming().user_id == existing().user_id &&
         incoming().title == existing().title &&
         incoming().description == existing().description &&
         incoming().category == existing().category &&
         incoming().diff(existing()).affectedKeys().hasOnly(['likes_count', 'updated_at'])) ||
        isAdmin()
      );
      allow delete: if isValidId(ideaId) && isSignedIn() &&
        (existing().user_id == request.auth.uid || isAdmin());
    }

    // 6. Idea Likes
    match /idea_likes/{likeId} {
      allow get, list: if true;
      allow create: if isValidId(likeId) && isSignedIn() && isValidIdeaLike(incoming()) &&
        incoming().user_id == request.auth.uid;
      allow update: if false; // Likes are immutable
      allow delete: if isValidId(likeId) && isSignedIn() &&
        (existing().user_id == request.auth.uid || isAdmin());
    }

    // 7. Chat Messages
    match /chat_messages/{messageId} {
      allow get, list: if true;
      allow create: if isValidId(messageId) && isSignedIn() && isValidChatMessage(incoming()) &&
        incoming().user_id == request.auth.uid;
      allow update: if false; // Chat records are immutable
      allow delete: if isValidId(messageId) && isAdmin();
    }
  }
}
